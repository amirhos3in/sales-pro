# PostgreSQL (Supabase or any hosted Postgres). Leave empty to use embedded PGlite in data/pglite.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexsell
PGLITE_DIR=data/pglite

# Cloud speech and the optional objection writer. Without these, the copilot uses the Persian playbook
# and the browser Web Speech API. No GPU is required.
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Node platform (HTTP + WebSocket). Next.js dev stays on PORT.
PLATFORM_PORT=43124
PORT=43123
HOSTNAME=0.0.0.0

# Public origin of the platform when the site is hosted apart from it.
# Example: https://api.example.com
NEXT_PUBLIC_PLATFORM_URL=
